NODE_ENV=development
PORT=3000

TELEGRAM_BOT_TOKEN=123456:replace-me
# true = do not connect to Telegram (REST/Swagger only)
BOT_DISABLED=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=choykontakt
# Local dev. Inside docker compose this is overridden to host "db".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/choykontakt

# Startup: app waits for DB, applies ./drizzle migrations, seeds reference data.
RUN_MIGRATIONS=true
RUN_SEED=true
DB_WAIT_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000
